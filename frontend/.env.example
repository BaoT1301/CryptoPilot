# WARNING: every VITE_* value is inlined into the public JS bundle at build time.
# Anyone can read them from the deployed site. Never put a real secret here.

# ---- Backend ----
# Full REST base URL, INCLUDING the /api suffix, no trailing slash.
# Local dev:  http://localhost:3000/api
VITE_API_URL=https://your-backend.up.railway.app/api

# Optional. Socket.IO origin. Defaults to VITE_API_URL with /api stripped,
# which is correct because the backend serves websockets on the same port.
# VITE_SOCKET_URL=https://your-backend.up.railway.app

# ---- Routing ----
# Only set this when serving from a subpath (e.g. GitHub Pages "/crypto-pilot/").
# Leave unset for Railway, which serves from the domain root.
# VITE_BASE_PATH=/

# ---- Dev only ----
# Target for the Vite dev-server /api proxy.
# VITE_DEV_API_PROXY=http://localhost:3000

# ---- BunnyCDN avatar upload ----
# SECURITY: these ship in the client bundle. VITE_BUNNY_STORAGE_PASSWORD is a
# storage WRITE key and is publicly extractable from the deployed site. Treat any
# key used here as compromised. The correct fix is to proxy uploads through the
# backend; until then, leave these blank to disable avatar upload.
VITE_BUNNY_STORAGE_NAME=
VITE_BUNNY_STORAGE_PASSWORD=
VITE_BUNNY_PULL_URL=
