# ---- Server ----
# Railway injects PORT automatically; leave unset in production.
PORT=3000

# ---- Database ----
# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# ---- CORS ----
# Exact origin of the deployed frontend: scheme + host, NO trailing slash, no path.
# Used by both Express CORS (src/server.ts) and Socket.IO (src/websocket/priceSocket.ts).
# Local dev: http://localhost:5173
FRONTEND_URL=https://your-frontend.up.railway.app

# ---- Auth ----
# All three MUST be at least 32 characters or the app throws on sign/verify.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=
JWT_REFRESH_KEY=
RESET_PASSWORD_SECRET=

# Set to true when frontend and backend are on different domains over HTTPS.
# Emits SameSite=None; Secure on auth cookies so the browser will keep them.
CROSS_SITE_COOKIES=true

# ---- Email ----
MAIL_FROM_NAME=CryptoPilot
MAIL_FROM_EMAIL=hello@demomailtrap.co

# ---- AI chat ----
# Required by POST /api/chat. Without it every chat request returns 500.
OPENAI_API_KEY=

# ---- Price feed ----
# Optional. Public Binance.US ticker stream, no API key needed. Has a working default.
BINANCE_WS=wss://stream.binance.us:9443/stream?streams=btcusdt@ticker/ethusdt@ticker/bnbusdt@ticker/solusdt@ticker
